---
import InfoPage from "../components/InfoPage.astro";
const sections = [{ heading: "Static by design", body: ["This hub is a static site. It has no backend, database, authentication, contact form backend, analytics or user-submitted HTML."] }, { heading: "Minimal external surface", body: ["Site assets, styles and interface behavior are local. Public product links leave the site only when you choose to follow them. External links opened in a new tab use noopener and noreferrer."] }, { heading: "Honest limitations", body: ["GitHub Pages does not provide application-level control over every HTTP response header. The site uses a meta CSP for the static document and documents response-header limitations rather than claiming controls it cannot set."] }];
---
<InfoPage current="security" title="Security & privacy" description="The static security and privacy approach for the GK DEVELOPMENT hub." intro="A small static surface, explicit boundaries and a clear line between verified public information and private operational detail." sections={sections} note="This page describes the site architecture. Product privacy behavior is documented separately on each product policy page." />
