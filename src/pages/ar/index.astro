---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import ProductSignal from "../../components/ProductSignal.astro";
import products from "../../data/products.json";
import site from "../../data/site.json";
const publicProducts = products.filter((product) => product.visibility === "public").sort((a, b) => a.sortOrder - b.sortOrder);
const principles = [["الأداء", "نبقي التجربة قريبة من عنق الزجاجة الحقيقي."], ["الأمان", "نجعل حدود الثقة واضحة وقابلة للمراجعة."], ["الخصوصية", "نفضّل المعالجة المحلية وتقليل حركة البيانات."], ["قابلية الصيانة", "نبني أنظمة تظل مفهومة بعد الإطلاق."], ["الهندسة متعددة المنصات", "نختار الحد الفاصل المناسب لسطح المكتب والهاتف والويب."], ["الدليل", "نطلق المنتجات باختبارات قابلة للتكرار، لا بتسميات متفائلة."]];
const base = import.meta.env.BASE_URL;
---
<BaseLayout lang="ar" title={`${site.name} — برمجيات وألعاب وأنظمة`} description="هندسة منتجات مستقلة للبرمجيات والألعاب والأنظمة عبر سطح المكتب والهاتف والويب." canonicalPath="ar/" alternatePath="/" current="home" socialImage="/og/gk-development.svg" jsonLd={{"@context":"https://schema.org","@type":"Organization","name":site.name,"url":"https://melkhamesey2.github.io/ar/","description":"هندسة منتجات مستقلة للبرمجيات والألعاب والأنظمة عبر سطح المكتب والهاتف والويب.","sameAs":[site.github,site.itch,site.medium,site.reddit,site.linkedin]}}>
  <main id="main-content">
    <section class="hero"><div class="shell hero-grid"><div><p class="eyebrow">{site.name} · {site.descriptor}</p><h1>برمجيات. ألعاب. أنظمة. منتجات.</h1><p class="lede">هندسة منتجات مستقلة عبر سطح المكتب والهاتف والويب — نبني البرمجيات والألعاب وأنظمة الأعمال والأتمتة والمنتجات الرقمية.</p><div class="hero-actions"><a class="button primary" href={`${base}ar/products/`}>استكشف المنتجات ↗</a><a class="button ghost" href={`${base}ar/capabilities/`}>كيف نبني</a></div><p class="hero-note"><span class="status-line"><span class="status-dot" aria-hidden="true"></span>استوديو مستقل</span><span>·</span><span>إطلاق محسوب</span></p></div><ProductSignal lang="ar" /></div></section>
    <section class="section section-tint"><div class="shell"><div class="section-heading"><div><p class="eyebrow">01 / أعمال مختارة</p><h2>منتجات لها وجهة نظر.</h2></div><p>الإصدارات العامة هي الجزء المرئي من ممارسة أوسع لهندسة المنتجات. كل إصدار يمر عبر استخدام حقيقي وحدود واضحة ومسار إطلاق مقصود.</p></div><div class="product-grid">{publicProducts.map((product) => <ProductCard product={product} lang="ar" />)}</div></div></section>
    <section class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">02 / ما نبنيه</p><h2>من أول قيد إلى منتج قابل للشحن.</h2></div><p>تعمل GK DEVELOPMENT عبر الطبقات التي تجعل البرمجيات مفيدة: تعريف المنتج، تصميم الواجهة، سلوك التشغيل، حزم الإصدار والدليل التشغيلي.</p></div><div class="grid-3"><article class="card"><p class="card-kicker">برمجيات</p><h3>سطح مكتب، هاتف وويب</h3><p>تطبيقات مركزة وتجارب متعددة المنصات مبنية حول الأشخاص الذين يستخدمونها.</p></article><article class="card"><p class="card-kicker">أنظمة</p><h3>أعمال وأتمتة</h3><p>أنظمة تشغيلية وتدفقات بيانات وأتمتة تجعل الحالة واضحة والفشل محدودًا.</p></article><article class="card"><p class="card-kicker">تفاعلي</p><h3>ألعاب ومنتجات رقمية</h3><p>أنظمة قابلة للعب ومنتجات رقمية تهتم بالإحساس والأداء وسرعة التكرار.</p></article></div></div></section>
    <section class="section section-tint"><div class="shell"><div class="section-heading"><div><p class="eyebrow">03 / مبادئ هندسية</p><h2>صرامة هادئة حيث يكون الفرق مهمًا.</h2></div><p>هذه مبادئ عمل وليست ادعاءً بالكمال. توجه طريقة تحديد النطاق والبناء والفحص والحفاظ على قابلية الصيانة.</p></div><ul class="principle-list">{principles.map(([name, body]) => <li><strong>{name}</strong>{body}</li>)}</ul></div></section>
    <section class="section"><div class="shell product-callout"><div><p class="eyebrow">04 / الخصوصية بالتصميم</p><h2>جمع أقل. تحكم أكثر.</h2><p class="lede">لا يستخدم الموقع تحليلات أو متتبعات إعلانية أو ملفات تعريف للتسويق أو جمعًا خلفيًا للبيانات. تصف صفحات خصوصية المنتجات سلوك كل إصدار بوضوح.</p></div><a class="button ghost" href={`${base}ar/privacy/`}>اقرأ نهج الخصوصية ↗</a></div></section>
  </main>
</BaseLayout>
