---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Product } from "../data/types";
const { product, lang = "en" } = Astro.props as { product: Product; lang?: "en" | "ar" };
const isArabic = lang === "ar";
const base = import.meta.env.BASE_URL;
const locale = isArabic ? product.locales?.ar : undefined;
const productTitle = locale?.seoTitle ?? product.seoTitle;
const productDescription = locale?.seoDescription ?? product.seoDescription;
const productCategory = locale?.category ?? product.category;
const productShortDescription = locale?.shortDescription ?? product.shortDescription;
const productFullDescription = locale?.fullDescription ?? product.fullDescription;
const productFeatures = locale?.features ?? product.features;
const label = (en: string, ar: string) => isArabic ? ar : en;
---
<BaseLayout lang={lang} title={productTitle} description={productDescription} current="products" canonicalPath={isArabic ? `ar/products/${product.slug}/` : `products/${product.slug}/`} alternatePath={isArabic ? `products/${product.slug}/` : `ar/products/${product.slug}/`} jsonLd={{"@context":"https://schema.org","@type":"SoftwareApplication","name":product.name,"description":productDescription,"applicationCategory":"MultimediaApplication","operatingSystem":"Windows","offers":product.price ? {"@type":"Offer","price":product.price,"priceCurrency":product.currency} : undefined,"url":`https://melkhamesey2.github.io/${isArabic ? "ar/" : ""}products/${product.slug}/`}}>
  <main id="main-content">
    <section class="page-hero product-hero"><div class="shell product-hero-grid"><div><div class="breadcrumbs"><a href={`${base}${isArabic ? "ar/products/" : "products/"}`}>{label("Products", "المنتجات")}</a><span>/</span><span>{product.name}</span></div><p class="eyebrow">{productCategory} · {label("Released", "منشور")}</p><h1>{product.name}</h1><p class="lede">{productShortDescription}</p><div class="hero-actions"><a class="button primary" href={product.storeLinks[0]?.url} target="_blank" rel="noopener noreferrer">{label("View on itch.io", "عرض المنتج على itch.io")} ↗</a><a class="button ghost" href={`${base}${isArabic ? "ar/" : ""}privacy/${product.slug}/`}>{label("Privacy", "الخصوصية")}</a></div></div><div class="product-aside card"><div class="data-row"><span>{label("Status", "الحالة")}</span><strong>{label("Released", "منشور")}</strong></div><div class="data-row"><span>{label("Platform", "المنصة")}</span><strong>{product.platforms.join(" · ")}</strong></div><div class="data-row"><span>{label("Distribution", "التوزيع")}</span><strong>itch.io</strong></div><div class="data-row"><span>{label("Pricing", "السعر")}</span><strong>{product.price ? `${product.price} ${product.currency}` : label("See itch.io", "راجع itch.io")}</strong></div></div></div></section>
    <section class="section section-tint"><div class="shell"><div class="section-heading"><div><p class="eyebrow">01 / {label("Overview", "نظرة عامة")}</p><h2>{label("A focused local playback system.", "نظام تشغيل محلي مركز.")}</h2></div><p>{productFullDescription}</p></div><div class="grid-2"><article class="card"><p class="card-kicker">{label("DSP / EQ", "DSP / EQ")}</p><h3>{label("Shape the sound on your terms.", "اضبط الصوت بالطريقة التي تناسبك.")}</h3><p>{label("20-band EQ, bass, treble, stereo widening, clarity, AGC and reverb keep the processing close to the player.", "معادل صوتي من 20 نطاقًا، مع bass وtreble وتوسيع stereo وclarity وAGC وreverb، لتبقى المعالجة قريبة من تجربة التشغيل.")}</p></article><article class="card"><p class="card-kicker">{label("Offline / privacy", "محلي / خصوصية")}</p><h3>{label("Your library stays on your device.", "مكتبتك تبقى على جهازك.")}</h3><p>{label("The public privacy policy describes a local-first workflow without advertising SDKs, analytics, cloud synchronization or automatic remote telemetry.", "تصف سياسة الخصوصية العامة سير عمل محليًا دون حزم إعلانية أو تحليلات أو مزامنة سحابية أو قياس تلقائي عن بُعد.")}</p></article></div></div></section>
    <section class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">02 / {label("Capabilities", "القدرات")}</p><h2>{label("Built around listening, not feature noise.", "مصمم حول الاستماع، لا ضجيج الميزات.")}</h2></div><p>{label("A practical set of playback, library and presentation modes for everyday media work.", "مجموعة عملية من ميزات التشغيل والمكتبة والعرض للاستخدام اليومي.")}</p></div><ul class="feature-list">{productFeatures.map((feature) => <li>{feature}</li>)}</ul></div></section>
    <section class="section section-tint"><div class="shell"><div class="section-heading"><div><p class="eyebrow">03 / {label("Distribution", "التوزيع")}</p><h2>{label("One verified public path.", "مسار عام متحقق واحد.")}</h2></div><p>{label("Pending or unverified stores remain out of the public product record until their status is confirmed.", "تبقى المتاجر المعلقة أو غير المتحققة خارج السجل العام للمنتج حتى يتم تأكيد حالتها.")}</p></div><div class="product-callout"><div><h3>itch.io</h3><p>{label("Current public distribution link for GK SOUND SYSTEM.", "رابط التوزيع العام الحالي لـGK SOUND SYSTEM.")}</p></div><a class="button primary" href={product.storeLinks[0]?.url} target="_blank" rel="noopener noreferrer">{label("Open store page", "فتح صفحة المتجر")} ↗</a></div></div></section>
    <section class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">04 / {label("Notes", "ملاحظات")}</p><h2>{label("Public record, kept current.", "سجل عام يُحدّث بوضوح.")}</h2></div><p>{label("Version, price and release date are shown only when the public record has a verified value. Update the product data file when those facts change.", "تظهر النسخة والسعر وتاريخ الإصدار فقط عند توفر قيمة متحققة في السجل العام. حدّث ملف بيانات المنتج عندما تتغير هذه الحقائق.")}</p></div><div class="grid-2"><div class="card"><p class="card-kicker">{label("Privacy", "الخصوصية")}</p><a class="link-arrow" href={`${base}${isArabic ? "ar/" : ""}privacy/${product.slug}/`}>{label("Read the product policy", "قراءة سياسة المنتج")}</a></div><div class="card"><p class="card-kicker">{label("Support", "الدعم")}</p><a class="link-arrow" href={`${base}${isArabic ? "ar/" : ""}support/`}>{label("Find public support channels", "العثور على قنوات الدعم العامة")}</a></div></div></div></section>
  </main>
</BaseLayout>
