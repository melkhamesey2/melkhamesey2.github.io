---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Product } from "../data/types";
const { product, lang = "en" } = Astro.props as { product: Product; lang?: "en" | "ar" };
const isArabic = lang === "ar";
const base = import.meta.env.BASE_URL;
const locale = isArabic ? product.locales?.ar : undefined;
const productTitle = locale?.seoTitle ?? product.seoTitle;
const productDescription = locale?.seoDescription ?? product.seoDescription;
const productCategory = locale?.category ?? product.category;
const productShortDescription = locale?.shortDescription ?? product.shortDescription;
const productFullDescription = locale?.fullDescription ?? product.fullDescription;
const productFeatures = locale?.features ?? product.features;
const label = (en: string, ar: string) => isArabic ? ar : en;
const priceLabel = product.price !== null && product.currency
  ? new Intl.NumberFormat(isArabic ? "ar-EG" : "en-US", { style: "currency", currency: product.currency }).format(product.price)
  : label("Price not published", "السعر غير منشور");
const screenshotAlts = isArabic
  ? ["واجهة التشغيل الرئيسية في GK SOUND SYSTEM مع عناصر المكتبة والتحكم", "واجهة GK SOUND SYSTEM مع التشغيل وقائمة اللغات", "نظرة عامة مشروحة على التنقل والإجراءات السريعة في GK SOUND SYSTEM", "مختبر الصوت في GK SOUND SYSTEM مع معادل صوتي من 20 نطاقًا", "مختبر الصوت في GK SOUND SYSTEM مع أدوات DSP والصوت المكاني", "إعدادات GK SOUND SYSTEM للتحكم في الأعمال الفنية ووضع شاشة التوقف"]
  : ["GK SOUND SYSTEM now playing interface with library controls", "GK SOUND SYSTEM playback interface with language support", "GK SOUND SYSTEM feature overview with navigation and quick actions", "GK SOUND SYSTEM Audio Lab with 20-band equalizer controls", "GK SOUND SYSTEM Audio Lab with DSP and spatial sound controls", "GK SOUND SYSTEM settings with artwork and screen saver controls"];
---
<BaseLayout lang={lang} title={productTitle} description={productDescription} current="products" socialImage="/og/gk-sound-system.svg" canonicalPath={isArabic ? `ar/products/${product.slug}/` : `products/${product.slug}/`} alternatePath={isArabic ? `products/${product.slug}/` : `ar/products/${product.slug}/`} jsonLd={{"@context":"https://schema.org","@type":"SoftwareApplication","name":product.name,"description":productDescription,"applicationCategory":"MultimediaApplication","operatingSystem":"Windows","offers":product.price !== null ? {"@type":"Offer","price":product.price,"priceCurrency":product.currency} : undefined,"url":`https://melkhamesey2.github.io/${isArabic ? "ar/" : ""}products/${product.slug}/`}}>
  <main id="main-content">
    <section class="page-hero product-hero"><div class="shell product-hero-grid"><div><div class="breadcrumbs"><a href={`${base}${isArabic ? "ar/products/" : "products/"}`}>{label("Products", "المنتجات")}</a><span>/</span><span>{product.name}</span></div><p class="eyebrow">{productCategory} · {label("Released", "منشور")}</p><h1>{product.name}</h1><p class="lede">{productShortDescription}</p><div class="hero-actions"><a class="button primary" href={product.storeLinks[0]?.url} target="_blank" rel="noopener noreferrer">{label("View on itch.io", "عرض المنتج على itch.io")} ↗</a><a class="button ghost" href={`${base}${isArabic ? "ar/" : ""}privacy/${product.slug}/`}>{label("Privacy", "الخصوصية")}</a></div></div><div class="product-hero-side"><div class="product-media card">{product.logo && <img class="product-logo" src={product.logo} alt={label("GK SOUND SYSTEM product icon", "أيقونة منتج GK SOUND SYSTEM")} width="256" height="256" loading="eager" decoding="async" />}{product.heroImage && <img class="product-hero-image" src={product.heroImage} alt={label("GK SOUND SYSTEM Windows player interface", "واجهة مشغل GK SOUND SYSTEM لنظام Windows")} width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" />}</div><div class="product-aside card"><div class="data-row"><span>{label("Status", "الحالة")}</span><strong>{label("Released", "منشور")}</strong></div><div class="data-row"><span>{label("Version", "الإصدار")}</span><strong>{product.version}</strong></div><div class="data-row"><span>{label("Price", "السعر")}</span><strong>{priceLabel}</strong></div><div class="data-row"><span>{label("Platform", "المنصة")}</span><strong>{product.platforms.join(" · ")}</strong></div><div class="data-row"><span>{label("Distribution", "التوزيع")}</span><strong>itch.io</strong></div><div class="data-row"><span>{label("Interface", "الواجهة")}</span><strong>{label(`${product.interfaceLanguages} UI languages`, `${product.interfaceLanguages} لغة للواجهة`)}</strong></div></div></div></div></section>
    <section class="section section-tint"><div class="shell"><div class="section-heading"><div><p class="eyebrow">01 / {label("Overview", "نظرة عامة")}</p><h2>{label("A focused local playback system.", "نظام تشغيل محلي مركز.")}</h2></div><p>{productFullDescription}</p></div><div class="grid-2"><article class="card"><p class="card-kicker">{label("DSP / EQ", "DSP / EQ")}</p><h3>{label("Shape the sound on your terms.", "اضبط الصوت بالطريقة التي تناسبك.")}</h3><p>{label("20-band EQ, bass, treble, stereo widening, clarity, AGC and reverb keep the processing close to the player.", "معادل صوتي من 20 نطاقًا، مع bass وtreble وتوسيع stereo وclarity وAGC وreverb، لتبقى المعالجة قريبة من تجربة التشغيل.")}</p></article><article class="card"><p class="card-kicker">{label("Offline / privacy", "محلي / خصوصية")}</p><h3>{label("Your library stays on your device.", "مكتبتك تبقى على جهازك.")}</h3><p>{label("The public privacy policy describes a local-first workflow without advertising SDKs, analytics, cloud synchronization or automatic remote telemetry.", "تصف سياسة الخصوصية العامة سير عمل محليًا دون حزم إعلانية أو تحليلات أو مزامنة سحابية أو قياس تلقائي عن بُعد.")}</p></article></div></div></section>
    <section class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">02 / {label("Capabilities", "القدرات")}</p><h2>{label("Built around listening, not feature noise.", "مصمم حول الاستماع، لا ضجيج الميزات.")}</h2></div><p>{label("A practical set of playback, library and presentation modes for everyday media work.", "مجموعة عملية من ميزات التشغيل والمكتبة والعرض للاستخدام اليومي.")}</p></div><ul class="feature-list">{productFeatures.map((feature) => <li>{feature}</li>)}</ul></div></section>
    <section class="section section-tint"><div class="shell"><div class="section-heading"><div><p class="eyebrow">03 / {label("Formats & gallery", "الصيغ والمعرض")}</p><h2>{label("See the system in use.", "شاهد النظام أثناء الاستخدام.")}</h2></div><p>{label("Verified product visuals from the current store material. Images are served locally and are not remote embeds.", "صور المنتج المتحققة من مادة المتجر الحالية. تُخدم الصور محليًا وليست تضمينات خارجية.")}</p></div><div class="formats-block"><p class="card-kicker">{label("Supported formats", "الصيغ المدعومة")}</p><p class="format-list">{product.formats.join(" · ")}</p></div><div class="screenshot-gallery">{product.screenshots.map((screenshot, index) => <figure class="screenshot-figure"><img src={screenshot} alt={screenshotAlts[index] ?? `${product.name} ${label("product screenshot", "لقطة من المنتج")}`} width={product.screenshotDimensions[index]?.width ?? 1672} height={product.screenshotDimensions[index]?.height ?? 941} loading="lazy" decoding="async" /><figcaption>{label(`Screenshot ${index + 1}`, `لقطة ${index + 1}`)}</figcaption></figure>)}</div></div></section>
    <section class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">04 / {label("Distribution", "التوزيع")}</p><h2>{label("One verified public path.", "مسار عام متحقق واحد.")}</h2></div><p>{label("Pending or unverified stores remain out of the public product record until their status is confirmed.", "تبقى المتاجر المعلقة أو غير المتحققة خارج السجل العام للمنتج حتى يتم تأكيد حالتها.")}</p></div><div class="product-callout"><div><h3>itch.io</h3><p>{label("Current public distribution link for GK SOUND SYSTEM.", "رابط التوزيع العام الحالي لـGK SOUND SYSTEM.")}</p></div><a class="button primary" href={product.storeLinks[0]?.url} target="_blank" rel="noopener noreferrer">{label("Open store page", "فتح صفحة المتجر")} ↗</a></div></div></section>
    <section class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">05 / {label("Notes", "ملاحظات")}</p><h2>{label("Public record, kept current.", "سجل عام يُحدّث بوضوح.")}</h2></div><p>{label("Version and price are verified product-record fields. No release date is published because no verified release date was supplied. The last updated date records the product data refresh, not a release event.", "الإصدار والسعر حقول متحققة في سجل المنتج. لا يُنشر تاريخ إصدار لعدم توفر تاريخ متحقق. يسجل تاريخ التحديث الأخير تحديث بيانات المنتج، وليس حدث إصدار.")}</p></div><div class="grid-2"><div class="card"><p class="card-kicker">{label("Privacy", "الخصوصية")}</p><a class="link-arrow" href={`${base}${isArabic ? "ar/" : ""}privacy/${product.slug}/`}>{label("Read the product policy", "قراءة سياسة المنتج")}</a></div><div class="card"><p class="card-kicker">{label("Support", "الدعم")}</p><a class="link-arrow" href={`${base}${isArabic ? "ar/" : ""}support/`}>{label("Find public support channels", "العثور على قنوات الدعم العامة")}</a></div></div></div></section>
  </main>
</BaseLayout>
