---
import site from "../data/site.json";
const { lang = "en" } = Astro.props;
const base = import.meta.env.BASE_URL;
const isArabic = lang === "ar";
const publicLinks = [
  { label: "GitHub", url: site.github },
  { label: "Medium", url: site.medium },
  { label: "Reddit", url: site.reddit },
  { label: "itch.io", url: site.itch },
  { label: "LinkedIn", url: site.linkedin }
].filter((link) => Boolean(link.url));
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <a class="brand" href={isArabic ? `${base}ar/` : base}><span class="brand-mark" aria-hidden="true">GK</span><span class="brand-copy">{site.name}<small>{site.descriptor}</small></span></a>
        <p class="lede footer-lede">{isArabic ? "هندسة منتجات مستقلة للبرمجيات والألعاب والأنظمة." : site.description}</p>
      </div>
      <div>
        <p class="footer-heading">{isArabic ? "استكشف" : "Explore"}</p>
        <nav class="footer-links" aria-label={isArabic ? "روابط الاستكشاف" : "Explore links"}>
          <a href={`${base}${isArabic ? "ar/products/" : "products/"}`}>{isArabic ? "المنتجات" : "Products"}</a>
          <a href={`${base}${isArabic ? "ar/capabilities/" : "capabilities/"}`}>{isArabic ? "القدرات" : "Capabilities"}</a>
          <a href={`${base}${isArabic ? "ar/security/" : "security/"}`}>{isArabic ? "الأمان والخصوصية" : "Security & privacy"}</a>
          <a href={`${base}${isArabic ? "ar/privacy/" : "privacy/"}`}>{isArabic ? "الخصوصية" : "Privacy"}</a>
        </nav>
      </div>
      <div>
        <p class="footer-heading">{isArabic ? "حضور عام" : "Public presence"}</p>
        <nav class="footer-links" aria-label={isArabic ? "حضور GK العام" : "GK public presence"}>
          {publicLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}
          <a href={`mailto:${site.contactEmail}`}>{isArabic ? "تواصل عبر البريد" : "Email"}</a>
        </nav>
      </div>
    </div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><span>{isArabic ? "بدون تحليلات أو متتبعات" : "No analytics. No trackers."}</span></div>
  </div>
</footer>
